# Which try-on backend to use: "mock" (default) or "replicate".
# The mock provider runs offline and needs no credentials.
TRYON_PROVIDER=mock

# Only needed when TRYON_PROVIDER=replicate.
# Create a token at https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# Optional: pin a specific model version hash for the Replicate provider.
REPLICATE_TRYON_VERSION=

# Publicly reachable base URL for this deployment.
#
# Only needed when garment images are served from public/ as site-relative
# paths and a hosted try-on provider has to fetch them. A hosted model cannot
# reach localhost, so this must be a real public origin — resolution throws
# rather than guessing.
PUBLIC_ORIGIN=

# Which body-measurement backend to use: "local" (default) or "3dlook".
#
# "local" runs MediaPipe Pose in the browser: free, offline, and the photo never
# leaves the device. Changing this away from "local" means body photos start
# being transmitted to a third party, and the consent copy and privacy notice
# will update themselves to say so.
MEASUREMENT_PROVIDER=local

# Only needed when MEASUREMENT_PROVIDER=3dlook.
#
# That provider is a worked example, not a working integration: its request
# mapping is unverified and it throws by design. Gates G11-G15 in
# docs/07-body-measurement-buy-vs-build.md must be cleared before it is used.
THREEDLOOK_API_KEY=
